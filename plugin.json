{
  "formatVersion": 1,
  "id": "org.aimonitor.weather",
  "name": "Weather",
  "version": "1.2.0",
  "author": "AI Monitor contributors",
  "description": "Current weather in a configurable location, shown as a dedicated display view.",
  "viewLabel": "Weather",
  "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
  "minSceneProtocol": 1,
  "source": {
    "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m&daily=temperature_2m_max,temperature_2m_min&forecast_days=1&timezone=auto",
    "intervalSeconds": 900
  },
  "settings": [
    { "key": "city", "label": "City", "kind": "text", "default": "Berlin", "min": null, "max": null },
    { "key": "latitude", "label": "Latitude", "kind": "number", "default": 52.52, "min": -90, "max": 90 },
    { "key": "longitude", "label": "Longitude", "kind": "number", "default": 13.41, "min": -180, "max": 180 }
  ],
  "bindings": [
    { "name": "city", "path": "settings.city", "format": "text", "suffix": "", "map": {}, "fallback": "Location" },
    { "name": "temperature", "path": "current.temperature_2m", "format": "integer", "suffix": " C", "map": {}, "fallback": "-- C" },
    { "name": "wind", "path": "current.wind_speed_10m", "format": "integer", "suffix": " km/h", "map": {}, "fallback": "-- km/h" },
    { "name": "humidity", "path": "current.relative_humidity_2m", "format": "integer", "suffix": "", "map": {}, "fallback": "0" },
    { "name": "high", "path": "daily.temperature_2m_max.0", "format": "integer", "suffix": " C", "map": {}, "fallback": "-- C" },
    { "name": "low", "path": "daily.temperature_2m_min.0", "format": "integer", "suffix": " C", "map": {}, "fallback": "-- C" },
    { "name": "condition", "path": "current.weather_code", "format": "map", "suffix": "", "map": {
      "0": "Clear sky", "1": "Mostly clear", "2": "Partly cloudy", "3": "Overcast",
      "45": "Fog", "48": "Fog", "51": "Drizzle", "53": "Drizzle", "55": "Drizzle",
      "61": "Rain", "63": "Rain", "65": "Heavy rain", "71": "Snow", "73": "Snow",
      "75": "Heavy snow", "80": "Showers", "81": "Showers", "82": "Showers",
      "95": "Thunderstorm", "96": "Thunderstorm", "99": "Thunderstorm"
    }, "fallback": "Weather" }
  ],
  "localizations": {
    "de": {
      "Weather": "Wetter",
      "Weather data by Open-Meteo.com (CC BY 4.0)": "Wetterdaten von Open-Meteo.com (CC BY 4.0)",
      "Current weather in a configurable location, shown as a dedicated display view.": "Aktuelles Wetter fuer einen einstellbaren Ort als eigene Display-Ansicht.",
      "City": "Stadt",
      "Latitude": "Breitengrad",
      "Longitude": "Laengengrad",
      "Location": "Ort",
      "Clear sky": "Klarer Himmel",
      "Mostly clear": "Ueberwiegend klar",
      "Partly cloudy": "Teilweise bewoelkt",
      "Overcast": "Bedeckt",
      "Fog": "Nebel",
      "Drizzle": "Nieselregen",
      "Rain": "Regen",
      "Heavy rain": "Starkregen",
      "Snow": "Schnee",
      "Heavy snow": "Starker Schneefall",
      "Showers": "Schauer",
      "Thunderstorm": "Gewitter",
      "HIGH / LOW": "HOCH / TIEF",
      "HI / LO": "HO / TI",
      "Wind  {{wind}}": "Wind  {{wind}}",
      "Humidity {{humidity}}%": "Feuchte {{humidity}}%",
      "Weather by Open-Meteo.com": "Wetter von Open-Meteo.com"
    }
  },
  "scenes": {
    "portrait": {
      "background": 1580575,
      "nodes": [
        { "type": "text", "x": 55, "y": 55, "w": 890, "h": 85, "color": 11250603, "font": 20, "text": "{{city}}" },
        { "type": "rect", "x": 55, "y": 151, "w": 890, "h": 3, "color": 3717119 },
        { "type": "circle", "x": 690, "y": 225, "w": 180, "h": 135, "color": 16763745, "visibleWhen": { "binding": "condition", "equals": "Clear sky" } },
        { "type": "text", "x": 55, "y": 225, "w": 610, "h": 190, "color": 16777215, "font": 48, "text": "{{temperature}}" },
        { "type": "text", "x": 55, "y": 430, "w": 890, "h": 90, "color": 11250603, "font": 20, "text": "{{condition}}" },
        { "type": "rect", "x": 55, "y": 565, "w": 890, "h": 3, "color": 3717119 },
        { "type": "text", "x": 55, "y": 620, "w": 450, "h": 70, "color": 8680559, "font": 14, "text": "HIGH / LOW" },
        { "type": "text", "x": 55, "y": 688, "w": 890, "h": 85, "color": 16777215, "font": 20, "text": "{{high}} / {{low}}" },
        { "type": "text", "x": 55, "y": 798, "w": 890, "h": 65, "color": 11250603, "font": 16, "text": "Wind  {{wind}}" },
        { "type": "text", "x": 55, "y": 850, "w": 890, "h": 50, "color": 11250603, "font": 12, "text": "Humidity {{humidity}}%" },
        { "type": "bar", "x": 55, "y": 910, "w": 890, "h": 13, "color": 8680559, "trackColor": 3717119, "valueBinding": "humidity" },
        { "type": "text", "x": 55, "y": 930, "w": 890, "h": 55, "color": 8680559, "font": 12, "text": "Weather by Open-Meteo.com" }
      ]
    },
    "landscape": {
      "background": 1580575,
      "nodes": [
        { "type": "text", "x": 42, "y": 62, "w": 580, "h": 100, "color": 11250603, "font": 20, "text": "{{city}}" },
        { "type": "rect", "x": 42, "y": 176, "w": 915, "h": 4, "color": 3717119 },
        { "type": "circle", "x": 600, "y": 275, "w": 145, "h": 190, "color": 16763745, "visibleWhen": { "binding": "condition", "equals": "Clear sky" } },
        { "type": "text", "x": 42, "y": 270, "w": 540, "h": 215, "color": 16777215, "font": 48, "text": "{{temperature}}" },
        { "type": "text", "x": 42, "y": 525, "w": 540, "h": 95, "color": 11250603, "font": 20, "text": "{{condition}}" },
        { "type": "rect", "x": 770, "y": 275, "w": 3, "h": 460, "color": 3717119 },
        { "type": "text", "x": 800, "y": 285, "w": 180, "h": 75, "color": 8680559, "font": 14, "text": "HI / LO" },
        { "type": "text", "x": 800, "y": 375, "w": 180, "h": 130, "color": 16777215, "font": 16, "text": "{{high}}" },
        { "type": "text", "x": 800, "y": 500, "w": 180, "h": 100, "color": 11250603, "font": 16, "text": "{{low}}" },
        { "type": "text", "x": 42, "y": 700, "w": 700, "h": 85, "color": 11250603, "font": 16, "text": "Wind  {{wind}}" },
        { "type": "text", "x": 42, "y": 775, "w": 915, "h": 65, "color": 11250603, "font": 12, "text": "Humidity {{humidity}}%" },
        { "type": "bar", "x": 42, "y": 848, "w": 915, "h": 22, "color": 8680559, "trackColor": 3717119, "valueBinding": "humidity" },
        { "type": "text", "x": 42, "y": 895, "w": 915, "h": 65, "color": 8680559, "font": 12, "text": "Weather by Open-Meteo.com" }
      ]
    },
    "square": {
      "background": 1580575,
      "nodes": [
        { "type": "text", "x": 65, "y": 52, "w": 870, "h": 75, "color": 11250603, "font": 24, "text": "{{city}}" },
        { "type": "rect", "x": 65, "y": 147, "w": 870, "h": 3, "color": 3717119 },
        { "type": "circle", "x": 735, "y": 200, "w": 145, "h": 145, "color": 16763745, "visibleWhen": { "binding": "condition", "equals": "Clear sky" } },
        { "type": "text", "x": 65, "y": 195, "w": 630, "h": 130, "color": 16777215, "font": 48, "text": "{{temperature}}" },
        { "type": "text", "x": 65, "y": 355, "w": 870, "h": 75, "color": 11250603, "font": 24, "text": "{{condition}}" },
        { "type": "rect", "x": 65, "y": 490, "w": 870, "h": 3, "color": 3717119 },
        { "type": "text", "x": 65, "y": 545, "w": 870, "h": 60, "color": 8680559, "font": 16, "text": "HIGH / LOW" },
        { "type": "text", "x": 65, "y": 620, "w": 870, "h": 90, "color": 16777215, "font": 36, "text": "{{high}} / {{low}}" },
        { "type": "text", "x": 65, "y": 755, "w": 870, "h": 70, "color": 11250603, "font": 20, "text": "Wind  {{wind}}" },
        { "type": "text", "x": 65, "y": 835, "w": 870, "h": 44, "color": 11250603, "font": 14, "text": "Humidity {{humidity}}%" },
        { "type": "bar", "x": 65, "y": 890, "w": 870, "h": 20, "color": 8680559, "trackColor": 3717119, "valueBinding": "humidity" },
        { "type": "text", "x": 65, "y": 930, "w": 870, "h": 45, "color": 8680559, "font": 14, "text": "Weather by Open-Meteo.com" }
      ]
    }
  }
}
